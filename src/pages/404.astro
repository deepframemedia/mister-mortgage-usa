---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Page Not Found | Mister Mortgage USA"
  description="The page you're looking for doesn't exist. Return to Mister Mortgage USA, Miami's trusted mortgage broker."
  lang="en"
  hasTicker={false}
>
  <section class="loan-hero" style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;">
    <div class="loan-hero-content section-inner reveal">
      <span class="section-label">Error 404</span>
      <h1>Page <em>Not Found</em></h1>
      <p>The page you're looking for doesn't exist or has moved. Let's get you back on track.</p>
      <a class="btn btn-red" href="/">Back to Home</a>
    </div>
  </section>
</MainLayout>
